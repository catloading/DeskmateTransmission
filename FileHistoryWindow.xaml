<Window x:Class="DeskLink.FileHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="720" Height="480" MinWidth="530" MinHeight="320"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FAFBF8" FontFamily="{StaticResource UiFont}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="文件名" Style="{StaticResource Label}"/><TextBox x:Name="Query" Style="{StaticResource Entry}" TextChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="扩展名或「文件夹」" Style="{StaticResource Label}"/><TextBox x:Name="FileType" Style="{StaticResource Entry}" TextChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="收发日期" Style="{StaticResource Label}"/><DatePicker x:Name="Day" SelectedDateChanged="FilterChanged"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <ListView x:Name="Results" MouseDoubleClick="Reveal" BorderBrush="{StaticResource Line}">
        <ListView.View><GridView><GridViewColumn Header="名称" Width="225" DisplayMemberBinding="{Binding Content}"/>
          <GridViewColumn Header="大小" Width="115" DisplayMemberBinding="{Binding SizeText}"/>
          <GridViewColumn Header="收发时间" Width="185" DisplayMemberBinding="{Binding Byline}"/></GridView></ListView.View>
      </ListView>
      <TextBlock x:Name="Empty" Text="没有符合条件的文件" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Quiet}" IsHitTestVisible="False"/>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="在文件夹中显示" Click="Reveal" Style="{StaticResource TextButton}"/>
      <TextBlock x:Name="Feedback" Style="{StaticResource Quiet}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock Text="本机所有会话的记录保留" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="Retention" SelectionChanged="RetentionChanged" VerticalContentAlignment="Center">
        <ComboBoxItem Content="最近 200 条"/><ComboBoxItem Content="7 天"/><ComboBoxItem Content="30 天"/><ComboBoxItem Content="90 天"/><ComboBoxItem Content="长期"/>
      </ComboBox>
    </StackPanel>
  </Grid>
</Window>
