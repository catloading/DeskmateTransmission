<Window x:Class="DeskLink.PairWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设备连接" Icon="Assets/desklink.ico"
  Width="474" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
  FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Ink}" Background="#FAFBF8"
  UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Loaded="OnLoaded" Closed="OnClosed">
  <StackPanel Margin="28,24,28,22">
    <StackPanel Orientation="Horizontal">
      <Border Background="#E1EEE3" CornerRadius="12" Width="41" Height="41">
        <Path Data="{StaticResource Arrows}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" StrokeThickness="2" Width="21" Height="21"/>
      </Border>
      <TextBlock x:Name="Heading" FontSize="23" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="Intro" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,20"/>
    <StackPanel x:Name="HostPanel" Visibility="Collapsed">
      <Border CornerRadius="12" Background="#E6F0E4" BorderBrush="#D2E2D0" BorderThickness="1" Padding="17,14">
        <StackPanel><TextBlock Text="配对码" Style="{StaticResource Label}" Margin="0,0,0,6"/>
          <TextBox x:Name="InvitationCode" Text="正在生成…" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
            FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
            AutomationProperties.Name="配对码"/>
        </StackPanel>
      </Border>
      <TextBlock Text="本机地址" Style="{StaticResource Label}" Margin="0,17,0,6"/>
      <ComboBox x:Name="HostAddress" Height="34" VerticalContentAlignment="Center" Padding="7,3" AutomationProperties.Name="本机地址"/>
    </StackPanel>
    <StackPanel x:Name="JoinPanel" Visibility="Collapsed">
      <DockPanel Margin="0,0,0,6">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Style="{StaticResource TextButton}" Click="Refresh"/>
        <TextBlock Text="附近等待连接的电脑" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid><ComboBox x:Name="NearbyList" Height="34" VerticalContentAlignment="Center" Padding="7,3" SelectionChanged="ChooseNearby" AutomationProperties.Name="附近的电脑"/>
        <TextBlock x:Name="NearbyHint" Text="正在查找…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,30,0"/>
      </Grid>
      <TextBlock Text="对方地址或完整邀请" Style="{StaticResource Label}" Margin="0,15,0,6"/>
      <Grid><TextBox x:Name="AddressInput" Style="{StaticResource Entry}" MaxLength="512" TextChanged="AddressChanged" AutomationProperties.Name="对方地址或完整邀请"/>
        <TextBlock x:Name="AddressHint" Text="例如 192.168.1.8:42861" IsHitTestVisible="False" Foreground="#78857A" Margin="12,0" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="配对码" Style="{StaticResource Label}" Margin="0,15,0,6"/>
      <Grid><TextBox x:Name="CodeInput" Style="{StaticResource Entry}" FontFamily="{StaticResource MonoFont}" FontSize="17" CharacterCasing="Upper" MaxLength="32" TextChanged="CodeChanged" AutomationProperties.Name="输入配对码"/>
        <TextBlock x:Name="CodeHint" Text="输入创建端显示的 12 位配对码" IsHitTestVisible="False" Foreground="#78857A" Margin="12,0" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18" Margin="0,13,0,4" MinHeight="18"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
      <Button Content="取消" MinWidth="70" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="MainAction" Style="{StaticResource Primary}" MinWidth="104" IsDefault="True" Click="PrimaryClick"/>
    </StackPanel>
  </StackPanel>
</Window>
