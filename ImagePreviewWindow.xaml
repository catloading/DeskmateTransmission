<Window x:Class="DeskLink.ImagePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="发送截图" Width="530" Height="360"
    MinWidth="320" MinHeight="220" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#FAFBF8" FontFamily="{StaticResource UiFont}">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Recipient" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="{StaticResource Line}" CornerRadius="6" Padding="4">
      <Image x:Name="Preview" Stretch="Uniform"/>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="发送截图" Style="{StaticResource Primary}" Click="Send" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
