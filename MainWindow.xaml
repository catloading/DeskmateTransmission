<Window x:Class="DeskLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="同桌传 · 文件传输助手" Icon="Assets/desklink.ico"
  Width="1000" Height="660" MinWidth="790" MinHeight="520" WindowStartupLocation="CenterScreen"
  FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Ink}" Background="#FAFBF8"
  UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True"
  PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Closing="OnClosing" Closed="OnClosed">
  <Window.Resources>
    <Style x:Key="RosterTab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Face" CornerRadius="7" Padding="6,7" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#E6EEE4"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#EFF3ED" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22,16,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,0,0,18">
            <Border Background="{StaticResource Accent}" Width="42" Height="42" CornerRadius="12">
              <Path Data="{StaticResource Arrows}" Style="{StaticResource Icon}" Width="23" Height="23" Stroke="#F2F7DF" StrokeThickness="2.4"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="同桌传" FontSize="21" FontWeight="Bold"/>
              <TextBlock Text="局域网传输助手" Style="{StaticResource Quiet}" FontSize="11"/>
            </StackPanel>
          </StackPanel>
          <Border CornerRadius="9" Background="#E2E9E0" Padding="3" Margin="0,0,0,12">
            <UniformGrid Columns="2"><RadioButton x:Name="RecentTab" Content="最近会话" Style="{StaticResource RosterTab}" Checked="TabChanged"/>
              <RadioButton x:Name="DevicesTab" Content="我的设备" Style="{StaticResource RosterTab}" Checked="TabChanged"/></UniformGrid>
          </Border>
        </StackPanel>
        <Grid Grid.Row="1">
          <TextBlock x:Name="RosterEmpty" Text="正在查找附近设备…" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="7,13,7,0"/>
          <ListBox x:Name="Roster" AutomationProperties.Name="设备与会话列表" SelectionChanged="RosterSelectionChanged" Background="Transparent"
              BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Card" Background="Transparent" Padding="8,9" CornerRadius="9" Margin="0,0,0,3"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#E6ECE4"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#D8E8DA"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Left" Width="34" Height="34">
                  <Border CornerRadius="9" Background="#FEFFFC"><Path Data="{StaticResource Monitor}" Style="{StaticResource Icon}" Width="17" Height="17" Stroke="#43684F"/></Border>
                  <Ellipse x:Name="PresenceDot" Width="10" Height="10" Stroke="#FEFFFC" StrokeThickness="2" Fill="#A1A9A1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Stamp}" Style="{StaticResource Quiet}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceTip}" FontWeight="SemiBold" FontSize="13"/></DockPanel>
                  <DockPanel Margin="0,3,0,0">
                    <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="7" Padding="4,0" Margin="3,0,0,0" Visibility="{Binding HasUnread, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="{Binding UnreadLabel}" Foreground="White" FontSize="10"/></Border>
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource Quiet}" FontSize="11"/>
                  </DockPanel>
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="True"><Setter TargetName="PresenceDot" Property="Fill" Value="#B28B35"/></DataTrigger>
                <DataTrigger Binding="{Binding Online}" Value="True"><Setter TargetName="PresenceDot" Property="Fill" Value="#23815C"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <StackPanel Grid.Row="2">
          <Grid Margin="0,12,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="HostButton" Content="显示配对码" Style="{StaticResource Primary}" Padding="5,8" Click="CreateConnection" IsEnabled="False"/>
            <Button x:Name="JoinButton" Grid.Column="2" Content="输入配对码" Padding="5,8" Click="JoinConnection" IsEnabled="False"/>
          </Grid>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,9"/>
          <DockPanel Margin="2,0"><Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="更改" Click="ChangeFolder" ToolTip="更改接收文件夹"/>
            <Button x:Name="FolderButton" Style="{StaticResource TextButton}" Padding="0,5" Foreground="{StaticResource Ink}" HorizontalContentAlignment="Left" Click="OpenFolder">
              <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Folder}" Style="{StaticResource Icon}" Width="15" Height="15"/>
                <TextBlock Text="接收文件夹" Margin="8,0,0,0"/></StackPanel></Button></DockPanel>
          <TextBlock x:Name="FolderHint" Style="{StaticResource Quiet}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,0,0,7"/>
          <DockPanel Margin="2,3,0,0"><TextBlock DockPanel.Dock="Left" Text="本机" Style="{StaticResource Quiet}" FontSize="11" Margin="0,0,7,0"/>
            <TextBlock x:Name="LocalName" Style="{StaticResource Quiet}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Padding="27,21" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#FEFFFC">
        <DockPanel>
          <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="···" Style="{StaticResource TextButton}" FontSize="19" VerticalAlignment="Center"
              Margin="5,0,0,0" Visibility="Collapsed" AutomationProperties.Name="设备选项" ToolTip="设备选项" Click="DeviceOptions">
            <Button.ContextMenu><ContextMenu><MenuItem Header="取消与此设备的配对" Click="ForgetDevice"/></ContextMenu></Button.ContextMenu>
          </Button>
          <Button x:Name="FileHistory" DockPanel.Dock="Right" Content="会话文件" Click="ShowFiles" Style="{StaticResource TextButton}" VerticalAlignment="Center" Margin="4,0"/>
          <Button x:Name="HeaderAction" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource TextButton}" Visibility="Collapsed" Click="DeviceAction" Margin="6,0,0,0"/>
          <Border x:Name="StatusBadge" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="14" Background="#E9EEE7" Padding="10,5">
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#738078" Margin="0,0,6,0"/>
              <TextBlock x:Name="StatusLabel" Text="未连接" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
          </Border>
          <StackPanel><TextBlock x:Name="ChatTitle" Text="传输会话" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ConversationHint" Text="选择一台设备，查看消息和文件" Style="{StaticResource Quiet}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,4">
          <Viewbox Width="226" Height="88" HorizontalAlignment="Center">
            <Canvas Width="230" Height="88">
              <Rectangle Canvas.Left="4" Canvas.Top="11" Width="70" Height="48" RadiusX="6" RadiusY="6" Fill="#DCEBE0" Stroke="#3F725C" StrokeThickness="2"/>
              <Rectangle Canvas.Left="10" Canvas.Top="17" Width="58" Height="33" RadiusX="2" RadiusY="2" Fill="#FAFCF6"/>
              <Path Data="M 32,60 L 31,69 L 21,71 L 56,71 L 46,69 L 45,60" Fill="#C7DBCA" Stroke="#3F725C" StrokeThickness="1.7" StrokeLineJoin="Round"/>
              <Path Data="M 79,40 L 151,40" Stroke="#8CA997" StrokeThickness="2" StrokeDashArray="1 3" StrokeDashCap="Round"/>
              <Ellipse Canvas.Left="96" Canvas.Top="21" Width="38" Height="38" Fill="#E6EED2" Stroke="#B5CAA4"/>
              <Path Canvas.Left="105" Canvas.Top="31" Data="{StaticResource Arrows}" Stroke="#497553" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Rectangle Canvas.Left="157" Canvas.Top="20" Width="62" Height="41" RadiusX="4" RadiusY="4" Fill="#E2ECE1" Stroke="#3F725C" StrokeThickness="2"/>
              <Rectangle Canvas.Left="162" Canvas.Top="25" Width="52" Height="31" RadiusX="1" RadiusY="1" Fill="#FAFCF6"/>
              <Path Data="M 157,61 L 219,61 L 228,68 Q 228,71 224,71 L 152,71 Q 149,71 149,68 Z" Fill="#C7DBCA" Stroke="#3F725C" StrokeThickness="1.7" StrokeLineJoin="Round"/>
              <Path Data="M 178,64 L 197,64" Stroke="#89A88D" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="EmptyTitle" Text="连接另一台电脑" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,7"/>
          <TextBlock x:Name="EmptyHint" Text="在一台电脑上显示配对码，然后用另一台输入。" Style="{StaticResource Quiet}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
            Padding="26,15,26,10" Visibility="Collapsed">
          <ItemsControl x:Name="ChatList" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel x:Name="Message" HorizontalAlignment="Left" MaxWidth="410" Margin="0,3,0,11">
                <TextBlock x:Name="Byline" Text="{Binding Byline}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,2,5"/>
                <Border x:Name="Bubble" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3,12,12,12" Padding="12,9">
                  <StackPanel>
                    <TextBox x:Name="TextBody" Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                        BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" Padding="0" FontSize="14"
                        MaxHeight="230" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel x:Name="FileBody" Visibility="Collapsed" Width="270">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="39" Background="#E5EDDA" CornerRadius="7" HorizontalAlignment="Left">
                          <Path Data="{StaticResource Document}" Style="{StaticResource Icon}" Width="17" Height="21" Stroke="#4E6F49"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                          <TextBlock Text="{Binding Content}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Content}"/>
                          <TextBlock Text="{Binding SizeText}" Style="{StaticResource Quiet}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                      <ProgressBar Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Height="4" Margin="0,10,0,0"
                         Value="{Binding Percent, Mode=OneWay}" Maximum="100" Background="#DCE4D9" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <WrapPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                  <TextBlock x:Name="Delivery" MaxWidth="280" TextWrapping="Wrap" Text="{Binding StateText}" VerticalAlignment="Center" Style="{StaticResource Quiet}" FontSize="11" Margin="2,0,5,0"/>
                  <Button Content="重试" Style="{StaticResource TextButton}" Click="RetryQueued" Visibility="{Binding CanRetry, Converter={StaticResource VisibleIf}}"/>
                  <Button Content="重新选择" Style="{StaticResource TextButton}" Click="ReselectQueued" Visibility="{Binding CanReselect, Converter={StaticResource VisibleIf}}"/>
                  <Button Content="取消" Style="{StaticResource TextButton}" Click="CancelQueued" Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}"/>
                  <Button x:Name="CopyButton" Style="{StaticResource TextButton}" Content="复制" Click="CopyMessage" FontSize="11"/>
                  <Button Style="{StaticResource TextButton}" FontSize="11" Content="在文件夹中显示" Click="RevealFile"
                    Visibility="{Binding HasPath, Converter={StaticResource VisibleIf}}"/>
                </WrapPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mine}" Value="True">
                  <Setter TargetName="Message" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Byline" Property="TextAlignment" Value="Right"/><Setter TargetName="Footer" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Bubble" Property="Background" Value="#E2F1E7"/><Setter TargetName="Bubble" Property="BorderBrush" Value="#CEE2D3"/>
                  <Setter TargetName="Bubble" Property="CornerRadius" Value="12,3,12,12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFile}" Value="True"><Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="FileBody" Property="Visibility" Value="Visible"/><Setter TargetName="CopyButton" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True"><Setter TargetName="Delivery" Property="Foreground" Value="#A73F31"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <StackPanel Grid.Row="2" Margin="24,0,24,18">
        <Border x:Name="NoticeBox" Visibility="Collapsed" Background="#EEF1DE" CornerRadius="7" Padding="10,6" Margin="0,0,0,7">
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#3F573B"/>
        </Border>
        <Border x:Name="ComposeBox" Background="White" CornerRadius="13" BorderBrush="#CDD9CE" BorderThickness="1" Padding="13,10,11,9">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <TextBox x:Name="Draft" AutomationProperties.Name="消息内容" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                MinHeight="43" MaxHeight="103" MaxLength="32768" BorderThickness="0" Padding="2,1" Background="Transparent" Foreground="{StaticResource Ink}"
                TextChanged="DraftChanged" PreviewKeyDown="DraftKeyDown"/>
              <TextBlock x:Name="DraftHint" Margin="4,2" Foreground="#748278" Text="输入消息…" IsHitTestVisible="False"/>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,7,0,0" LastChildFill="False">
              <Button x:Name="FileButton" DockPanel.Dock="Left" Style="{StaticResource TextButton}" Foreground="{StaticResource Ink}"
                Padding="5,6" Click="PickFiles" IsEnabled="False" ToolTip="选择文件，也可以将多个文件拖入窗口">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Attach}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                  <TextBlock Text="发送文件" Margin="6,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="FolderSend" DockPanel.Dock="Left" Content="发文件夹" Click="PickFolder" Style="{StaticResource TextButton}" Padding="6" IsEnabled="False"/>
              <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SendMessage" IsEnabled="False" Padding="13,6" ToolTip="Enter 发送，Shift+Enter 换行">
                <StackPanel Orientation="Horizontal"><TextBlock Text="发送"/><Path Data="{StaticResource Send}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <TextBlock DockPanel.Dock="Right" Text="Shift + Enter 换行" Style="{StaticResource Quiet}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
            </DockPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
